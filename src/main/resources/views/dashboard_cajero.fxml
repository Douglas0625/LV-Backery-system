<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane
    xmlns="http://javafx.com/javafx/17"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="controller.DashboardCajeroController"
    style="-fx-background-color: #F5F3EF;">

    <!-- ===== SIDEBAR FIJO ===== -->
    <left>
        <VBox fx:id="sidebar"
              prefWidth="220"
              style="-fx-background-color: #4B3832; -fx-spacing: 12;">
            <padding><Insets top="25" left="10" right="10" bottom="10"/></padding>
            <children>

                <Label text="LV BAKERY" alignment="CENTER"
                       prefWidth="200" textFill="WHITE" textAlignment="CENTER">
                    <font><Font name="Segoe UI Bold" size="26"/></font>
                </Label>

                <Label text="Inventory &amp; management" alignment="CENTER"
                       prefWidth="200" textFill="#f4d764" textAlignment="CENTER">
                    <font><Font name="Segoe UI" size="11"/></font>
                </Label>

                <Region prefHeight="10"/>

                <!-- BTN DASHBOARD -->
                <Button fx:id="btnDashboard"
                        text="Dashboard" textFill="WHITE"
                        alignment="CENTER_LEFT" graphicTextGap="12"
                        maxWidth="Infinity" prefHeight="44"
                        onAction="#mostrarDashboardHome"
                        style="-fx-background-color: #6B4F4F; -fx-background-radius: 8; -fx-padding: 10 15 10 15;">
                    <graphic><ImageView fitWidth="24" fitHeight="24" preserveRatio="true">
                        <image><Image url="@../img/panel.png"/></image>
                    </ImageView></graphic>
                    <font><Font name="Segoe UI" size="14"/></font>
                    <cursor><Cursor fx:constant="HAND"/></cursor>
                </Button>

                <!-- BTN PEDIDOS -->
                <Button fx:id="btnPedidos"
                        text="Pedidos" textFill="WHITE"
                        alignment="CENTER_LEFT" graphicTextGap="12"
                        maxWidth="Infinity" prefHeight="44"
                        onAction="#mostrarPedidos"
                        style="-fx-background-color: transparent; -fx-background-radius: 8; -fx-padding: 10 15 10 15;">
                    <graphic><ImageView fitWidth="24" fitHeight="24" preserveRatio="true">
                        <image><Image url="@../img/carrito-de-compras.png"/></image>
                    </ImageView></graphic>
                    <font><Font name="Segoe UI" size="14"/></font>
                    <cursor><Cursor fx:constant="HAND"/></cursor>
                </Button>

                <!-- BTN VENTAS -->
                <Button fx:id="btnVentas"
                        text="Ventas" textFill="WHITE"
                        alignment="CENTER_LEFT" graphicTextGap="12"
                        maxWidth="Infinity" prefHeight="44"
                        onAction="#mostrarVentas"
                        style="-fx-background-color: transparent; -fx-background-radius: 8; -fx-padding: 10 15 10 15;">
                    <graphic><ImageView fitWidth="24" fitHeight="24" preserveRatio="true">
                        <image><Image url="@../img/dinero.png"/></image>
                    </ImageView></graphic>
                    <font><Font name="Segoe UI" size="14"/></font>
                    <cursor><Cursor fx:constant="HAND"/></cursor>
                </Button>

                <Region VBox.vgrow="ALWAYS"/>

                <!-- BTN CERRAR SESION -->
                <Button text="Cerrar Sesión" textFill="#ffaaaa"
                        alignment="CENTER_LEFT" graphicTextGap="12"
                        maxWidth="Infinity" prefHeight="44"
                        onAction="#cerrarSesion"
                        style="-fx-background-color: transparent; -fx-background-radius: 8; -fx-padding: 10 15 10 15;">
                    <graphic><ImageView fitWidth="22" fitHeight="22" preserveRatio="true">
                        <image><Image url="@../img/cerrar-sesion.png"/></image>
                    </ImageView></graphic>
                    <font><Font name="Segoe UI" size="13"/></font>
                    <cursor><Cursor fx:constant="HAND"/></cursor>
                </Button>

            </children>
        </VBox>
    </left>

    <!-- ===== AREA PRINCIPAL ===== -->
    <center>
        <VBox style="-fx-background-color: #F5F3EF;">

            <!-- NAVBAR FIJA -->
            <HBox fx:id="navbar" alignment="CENTER_LEFT" prefHeight="55" minHeight="55"
                  style="-fx-background-color: #F5F3EF; -fx-border-color: #4B3832; -fx-border-width: 0 0 2 0;">
                <padding><Insets left="20" right="15"/></padding>
                <children>
                    <Label fx:id="lblTituloModulo" text="Bakery Manager" textFill="#4B3832">
                        <font><Font name="Segoe UI Bold" size="18"/></font>
                    </Label>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="lblNombreUsuario" text="" textFill="#4B3832">
                        <font><Font name="Segoe UI" size="12"/></font>
                    </Label>
                    <ImageView fitHeight="22" fitWidth="22" preserveRatio="true">
                        <HBox.margin><Insets left="10"/></HBox.margin>
                        <image><Image url="@../img/avatar.png"/></image>
                    </ImageView>
                </children>
            </HBox>

            <!-- CONTENEDOR DINAMICO -->
            <StackPane fx:id="contenedorPrincipal" VBox.vgrow="ALWAYS"
                       style="-fx-background-color: #F5F3EF;"/>

        </VBox>
    </center>

</BorderPane>
