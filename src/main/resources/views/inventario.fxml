<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.Cursor?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="681.0"
            prefWidth="998.0"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1">

    <!-- SIDEBAR -->
    <left>

        <VBox prefWidth="223.0"
              style="-fx-background-color: #4B3832;
                     -fx-padding: 10;
                     -fx-spacing: 15;">

            <children>

                <Label text="LV BAKERY"
                       textFill="WHITE"
                       alignment="CENTER"
                       prefWidth="207">

                    <font>
                        <Font name="Segoe UI Bold" size="28"/>
                    </font>

                </Label>

                <Label text="Inventory &amp; management"
                       textFill="#f4d764">

                    <font>
                        <Font name="Segoe UI" size="12"/>
                    </font>

                </Label>

            </children>

        </VBox>

    </left>

    <!-- CENTRO -->
    <center>

        <ScrollPane fitToWidth="true"
                    pannable="true"
                    style="-fx-background:#F5F3EF;
                           -fx-background-color:#F5F3EF;">

            <content>

                <VBox spacing="0"
                      prefWidth="1200.0"
                      style="-fx-background-color: #F5F3EF;">

                    <children>

                        <!-- HEADER -->
                        <HBox alignment="CENTER"
                              prefHeight="55.0"
                              style="-fx-border-color: #4B3832;
                                     -fx-border-width: 2;
                                     -fx-background-color: #F5F3EF;">

                            <children>

                                <Label text="Bakery Manager"
                                       textFill="#4b3832">

                                    <font>
                                        <Font name="System Bold" size="18"/>
                                    </font>

                                    <padding>
                                        <Insets left="5"/>
                                    </padding>

                                </Label>

                                <Region HBox.hgrow="ALWAYS"/>

                                <Label text="Admin"
                                       textFill="#4b3832">

                                    <font>
                                        <Font name="Segoe UI" size="12"/>
                                    </font>

                                </Label>

                                <Button style="-fx-background-color: transparent;">

                                    <graphic>

                                        <ImageView fitHeight="23"
                                                   fitWidth="25"
                                                   preserveRatio="true">

                                            <image>
                                                <Image url="@../img/avatar.png"/>
                                            </image>

                                        </ImageView>

                                    </graphic>

                                </Button>

                            </children>

                        </HBox>

                        <!-- TITULO -->
                        <HBox alignment="CENTER"
                              prefHeight="78.0">

                            <VBox.margin>
                                <Insets top="10"
                                        left="10"
                                        right="10"
                                        bottom="10"/>
                            </VBox.margin>

                            <children>

                                <VBox alignment="CENTER_LEFT">

                                    <children>

                                        <Label text="Gestión de Inventario"
                                               textFill="#4b3832">

                                            <font>
                                                <Font name="Segoe UI Bold" size="20"/>
                                            </font>

                                        </Label>

                                        <Label text="Control de stock, compras y ajustes de ingredientes."/>

                                    </children>

                                </VBox>

                                <Region HBox.hgrow="ALWAYS"/>

                                <Button text="Nuevo Ingrediente"
                                        textFill="WHITE"
                                        style="-fx-background-color: #4b3832;">

                                    <HBox.margin>
                                        <Insets right="30"/>
                                    </HBox.margin>

                                </Button>

                            </children>

                        </HBox>

                        <!-- SECCION PRINCIPAL -->
                        <HBox spacing="15"
                              VBox.vgrow="ALWAYS">

                            <VBox.margin>
                                <Insets left="10"
                                        right="10"
                                        bottom="10"/>
                            </VBox.margin>

                            <children>

                                <!-- TABLA -->
                                <VBox spacing="15"
                                      prefWidth="700.0"
                                      style="-fx-background-color: white;
                                             -fx-background-radius: 10;
                                             -fx-border-radius: 10;
                                             -fx-border-color: #E5E1DC;
                                             -fx-padding: 15;"
                                      HBox.hgrow="ALWAYS">

                                    <children>

                                        <HBox alignment="CENTER_LEFT">

                                            <children>

                                                <Label text="Ingredientes"
                                                       textFill="#4B3832">

                                                    <font>
                                                        <Font name="Segoe UI Bold" size="22"/>
                                                    </font>

                                                </Label>

                                                <Region HBox.hgrow="ALWAYS"/>

                                                <TextField promptText="Buscar ingrediente..."
                                                           prefWidth="220"/>

                                            </children>

                                        </HBox>

                                        <!-- TABLA INGREDIENTES -->
                                        <TableView prefHeight="450"
                                                   VBox.vgrow="ALWAYS">

                                            <columns>

                                                <TableColumn prefWidth="220"
                                                             text="NOMBRE"/>

                                                <TableColumn prefWidth="90"
                                                             text="STOCK"/>

                                                <TableColumn prefWidth="120"
                                                             text="COSTO x GR"/>

                                                <TableColumn prefWidth="120"
                                                             text="ESTADO"/>

                                                <TableColumn prefWidth="120"
                                                             text="ACCIONES"/>

                                            </columns>

                                        </TableView>

                                    </children>

                                </VBox>

                                <!-- PANEL DERECHO -->
                                <VBox spacing="15"
                                      prefWidth="340">

                                    <children>

                                        <!-- COMPRA -->
                                        <VBox spacing="12"
                                              style="-fx-background-color: white;
                                                     -fx-background-radius: 10;
                                                     -fx-border-radius: 10;
                                                     -fx-border-color: #E5E1DC;
                                                     -fx-padding: 15;">

                                            <children>

                                                <Label text="Compra de Ingredientes"
                                                       textFill="#4B3832">

                                                    <font>
                                                        <Font name="Segoe UI Bold" size="20"/>
                                                    </font>

                                                </Label>

                                                <VBox spacing="5">

                                                    <children>

                                                        <Label text="Proveedor"/>

                                                        <ComboBox prefWidth="260"
                                                                  promptText="Seleccionar proveedor"/>

                                                    </children>

                                                </VBox>

                                                <VBox spacing="5">

                                                    <children>

                                                        <Label text="Ingrediente"/>

                                                        <ComboBox prefWidth="260"
                                                                  promptText="Seleccionar ingrediente"/>

                                                    </children>

                                                </VBox>

                                                <HBox spacing="10">

                                                    <children>

                                                        <VBox spacing="5">

                                                            <children>

                                                                <Label text="Cantidad"/>

                                                                <TextField prefWidth="120"
                                                                           promptText="0"/>

                                                            </children>

                                                        </VBox>

                                                        <VBox spacing="5">

                                                            <children>

                                                                <Label text="Subtotal"/>

                                                                <TextField editable="false"
                                                                           prefWidth="120"
                                                                           promptText="0.00"/>

                                                            </children>

                                                        </VBox>

                                                    </children>

                                                </HBox>

                                                <Button text="Registrar Compra"
                                                        textFill="WHITE"
                                                        prefWidth="260"
                                                        prefHeight="38"
                                                        style="-fx-background-color: #4B3832;"/>

                                            </children>

                                        </VBox>

                                        <!-- AJUSTE -->
                                        <VBox spacing="12"
                                              style="-fx-background-color: white;
                                                     -fx-background-radius: 10;
                                                     -fx-border-radius: 10;
                                                     -fx-border-color: #E5E1DC;
                                                     -fx-padding: 15;">

                                            <children>

                                                <Label text="Ajuste Manual"
                                                       textFill="#4B3832">

                                                    <font>
                                                        <Font name="Segoe UI Bold" size="20"/>
                                                    </font>

                                                </Label>

                                                <!-- NUEVO -->
                                                <VBox spacing="5">

                                                    <children>

                                                        <Label text="Ingrediente"/>

                                                        <ComboBox prefWidth="260"
                                                                  promptText="Seleccionar ingrediente"/>

                                                    </children>

                                                </VBox>

                                                <VBox spacing="5">

                                                    <children>

                                                        <Label text="Tipo de Movimiento"/>

                                                        <HBox spacing="10">

                                                            <children>

                                                                <Button text="Entrada"
                                                                        prefWidth="120"/>

                                                                <Button text="Salida"
                                                                        prefWidth="120"/>

                                                            </children>

                                                        </HBox>

                                                    </children>

                                                </VBox>

                                                <VBox spacing="5">

                                                    <children>

                                                        <Label text="Motivo"/>

                                                        <TextArea prefHeight="80"
                                                                  wrapText="true"
                                                                  promptText="Describa el motivo..."/>

                                                    </children>

                                                </VBox>

                                                <Button text="Aplicar Ajuste"
                                                        prefWidth="260"
                                                        prefHeight="38"
                                                        textFill="#4B3832"
                                                        style="-fx-background-color: transparent;
                                                               -fx-border-color: #4B3832;
                                                               -fx-border-radius: 6;"/>

                                            </children>

                                        </VBox>

                                    </children>

                                </VBox>

                            </children>

                        </HBox>

                        <!-- HISTORIAL -->
                        <VBox spacing="15"
                              VBox.vgrow="ALWAYS"
                              style="-fx-background-color: white;
                                     -fx-background-radius: 10;
                                     -fx-border-radius: 10;
                                     -fx-border-color: #E5E1DC;
                                     -fx-padding: 15;">

                            <VBox.margin>
                                <Insets left="10"
                                        right="10"
                                        bottom="10"/>
                            </VBox.margin>

                            <children>

                                <Label text="Historial de Movimientos"
                                       textFill="#4B3832">

                                    <font>
                                        <Font name="Segoe UI Bold" size="20"/>
                                    </font>

                                </Label>

                                <TableView prefHeight="250"
                                           VBox.vgrow="ALWAYS">

                                    <columns>

                                        <TableColumn prefWidth="150"
                                                     text="FECHA"/>

                                        <TableColumn prefWidth="190"
                                                     text="INGREDIENTE"/>

                                        <TableColumn prefWidth="120"
                                                     text="TIPO"/>

                                        <TableColumn prefWidth="110"
                                                     text="CANTIDAD"/>

                                        <TableColumn prefWidth="220"
                                                     text="MOTIVO / PROVEEDOR"/>

                                        <TableColumn prefWidth="130"
                                                     text="USUARIO"/>

                                        <TableColumn prefWidth="120"
                                                     text="ACCIONES"/>

                                    </columns>

                                </TableView>

                            </children>

                        </VBox>

                    </children>

                </VBox>

            </content>

        </ScrollPane>

    </center>

</BorderPane>