            </Button>
            <Button alignment="CENTER_LEFT" graphicTextGap="12" mnemonicParsing="false" prefHeight="45.0" prefWidth="200.0" style="-fx-background-color: transparent;                                -fx-background-radius: 10;                                -fx-padding: 10 15 10 15;" text="Ventas" textFill="WHITE">
               <graphic>
                  <ImageView fitHeight="28.0" fitWidth="28.0" preserveRatio="true">
                     <image>
                        <Image url="@../img/dinero.png" />
                     </image>
                  </ImageView>
               </graphic>
               <font>
                  <Font name="Segoe UI" size="15.0" />
               </font>
               <cursor>
                  <Cursor fx:constant="HAND" />
               </cursor>
            </Button>
            <Button alignment="CENTER_LEFT" graphicTextGap="12" mnemonicParsing="false" prefHeight="45.0" prefWidth="200.0" style="-fx-background-color: transparent;                                -fx-background-radius: 10;                                -fx-padding: 10 15 10 15;" text="Recetas" textFill="WHITE">
               <graphic>
                  <ImageView fitHeight="28.0" fitWidth="28.0" preserveRatio="true">
                     <image>
                        <Image url="@../img/libro.png" />
                     </image>
                  </ImageView>
               </graphic>
               <font>
                  <Font name="Segoe UI" size="15.0" />
               </font>
               <cursor>
                  <Cursor fx:constant="HAND" />
               </cursor>
            </Button>
            <Button alignment="CENTER_LEFT" graphicTextGap="12" mnemonicParsing="false" prefHeight="45.0" prefWidth="200.0" style="-fx-background-color: transparent;                                -fx-background-radius: 10;                                -fx-padding: 10 15 10 15;" text="Reportes" textFill="WHITE">
               <graphic>
                  <ImageView fitHeight="28.0" fitWidth="28.0" preserveRatio="true">
                     <image>
                        <Image url="@../img/grafico-de-barras.png" />
                     </image>
                  </ImageView>
               </graphic>
               <font>
                  <Font name="Segoe UI" size="15.0" />
               </font>
               <cursor>
                  <Cursor fx:constant="HAND" />
               </cursor>
            </Button>
            <Button alignment="CENTER_LEFT" graphicTextGap="12" mnemonicParsing="false" prefHeight="45.0" prefWidth="200.0" style="-fx-background-color: #6B4F4F; -fx-background-radius: 10; -fx-padding: 10 15 10 15;" text="Inventario" textFill="WHITE">
               <graphic>
                  <ImageView fitHeight="28.0" fitWidth="28.0" preserveRatio="true">
                     <image>
                        <Image url="@../img/contenedor-de-comida.png" />
                     </image>
                  </ImageView>
               </graphic>
               <font>
                  <Font name="Segoe UI" size="15.0" />
               </font>
               <cursor>
                  <Cursor fx:constant="HAND" />
               </cursor>
            </Button>
            <Button alignment="CENTER_LEFT" graphicTextGap="12" mnemonicParsing="false" prefHeight="45.0" prefWidth="200.0" style="-fx-background-color: trasnparent; -fx-background-radius: 10; -fx-padding: 10 15 10 15;" text="Usuarios" textFill="WHITE">
               <graphic>
                  <ImageView fitHeight="28.0" fitWidth="28.0" preserveRatio="true">
