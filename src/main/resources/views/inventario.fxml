<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="controller.InventarioController">

    <!-- CENTRO -->
    <center>

        <ScrollPane fitToWidth="true" pannable="true" style="-fx-background:#F5F3EF;                            -fx-background-color:#F5F3EF;">

            <content>

                <VBox prefWidth="1200.0" spacing="0" style="-fx-background-color: #F5F3EF;">

                    <children>

                        <!-- HEADER -->

                        <!-- TITULO -->
                        <HBox alignment="CENTER" prefHeight="78.0">

                            <VBox.margin>
                                <Insets bottom="10" left="10" right="10" top="10" />
                            </VBox.margin>

                            <children>

                                <VBox alignment="CENTER_LEFT">

                                    <children>

                                        <Label text="Gestión de Inventario" textFill="#4b3832">

                                            <font>
                                                <Font name="Segoe UI Bold" size="20" />
                                            </font>

                                        </Label>

                                        <Label text="Control de stock, compras y ajustes de ingredientes." />

                                    </children>

                                </VBox>

                                <Region HBox.hgrow="ALWAYS" />

                                <Button style="-fx-background-color: #4b3832;" text="Nuevo Ingrediente" textFill="WHITE">

                                    <HBox.margin>
                                        <Insets right="30" />
                                    </HBox.margin>

                                </Button>

                            </children>

                        </HBox>

                        <!-- SECCION PRINCIPAL -->
                        <HBox spacing="15" VBox.vgrow="ALWAYS">

                            <VBox.margin>
                                <Insets bottom="10" left="10" right="10" />
                            </VBox.margin>

                            <children>

                                <!-- TABLA -->
                                <VBox prefWidth="700.0" spacing="15" style="-fx-background-color: white;                                              -fx-background-radius: 10;                                              -fx-border-radius: 10;                                              -fx-border-color: #E5E1DC;                                              -fx-padding: 15;" HBox.hgrow="ALWAYS">

                                    <children>

                                        <HBox alignment="CENTER_LEFT">

                                            <children>

                                                <Label text="Ingredientes" textFill="#4B3832">

                                                    <font>
                                                        <Font name="Segoe UI Bold" size="22" />
                                                    </font>

                                                </Label>

                                                <Region HBox.hgrow="ALWAYS" />

                                                <TextField prefWidth="220" promptText="Buscar ingrediente..." />

                                            </children>

                                        </HBox>

                                        <!-- TABLA INGREDIENTES -->
                                        <TableView prefHeight="450" VBox.vgrow="ALWAYS">

                                            <columns>

                                                <TableColumn prefWidth="220" text="NOMBRE" />

                                                <TableColumn prefWidth="90" text="STOCK" />

                                                <TableColumn prefWidth="120" text="COSTO x GR" />

                                                <TableColumn prefWidth="120" text="ESTADO" />

                                                <TableColumn prefWidth="120" text="ACCIONES" />

                                            </columns>

                                        </TableView>

                                    </children>

                                </VBox>

                                <!-- PANEL DERECHO -->
                                <VBox prefWidth="340" spacing="15">

                                    <children>

                                        <!-- COMPRA -->
                                        <VBox spacing="12" style="-fx-background-color: white;                                                      -fx-background-radius: 10;                                                      -fx-border-radius: 10;                                                      -fx-border-color: #E5E1DC;                                                      -fx-padding: 15;">

                                            <children>

                                                <Label text="Compra de Ingredientes" textFill="#4B3832">

                                                    <font>
                                                        <Font name="Segoe UI Bold" size="20" />
                                                    </font>

                                                </Label>

                                                <VBox spacing="5">

                                                    <children>

                                                        <Label text="Proveedor" />

                                                        <ComboBox prefWidth="260" promptText="Seleccionar proveedor" />

                                                    </children>

                                                </VBox>

                                                <VBox spacing="5">

                                                    <children>

                                                        <Label text="Ingrediente" />

                                                        <ComboBox prefWidth="260" promptText="Seleccionar ingrediente" />

                                                    </children>

                                                </VBox>

                                                <HBox spacing="10">

                                                    <children>

                                                        <VBox spacing="5">

                                                            <children>

                                                                <Label text="Cantidad" />

                                                                <TextField prefWidth="120" promptText="0" />

                                                            </children>

                                                        </VBox>

                                                        <VBox spacing="5">

                                                            <children>

                                                                <Label text="Subtotal" />

                                                                <TextField editable="false" prefWidth="120" promptText="0.00" />

                                                            </children>

                                                        </VBox>

                                                    </children>

                                                </HBox>

                                                <Button prefHeight="38" prefWidth="260" style="-fx-background-color: #4B3832;" text="Registrar Compra" textFill="WHITE" />

                                            </children>

                                        </VBox>

                                        <!-- AJUSTE -->
                                        <VBox spacing="12" style="-fx-background-color: white;                                                      -fx-background-radius: 10;                                                      -fx-border-radius: 10;                                                      -fx-border-color: #E5E1DC;                                                      -fx-padding: 15;">

                                            <children>

                                                <Label text="Ajuste Manual" textFill="#4B3832">

                                                    <font>
                                                        <Font name="Segoe UI Bold" size="20" />
                                                    </font>

                                                </Label>

                                                <!-- NUEVO -->
                                                <VBox spacing="5">

                                                    <children>

                                                        <Label text="Ingrediente" />

                                                        <ComboBox prefWidth="260" promptText="Seleccionar ingrediente" />

                                                    </children>

                                                </VBox>

                                                <VBox spacing="5">

                                                    <children>

                                                        <Label text="Tipo de Movimiento" />

                                                        <HBox spacing="10">

                                                            <children>

                                                                <Button prefWidth="120" text="Entrada" />

                                                                <Button prefWidth="120" text="Salida" />

                                                            </children>

                                                        </HBox>

                                                    </children>

                                                </VBox>

                                                <VBox spacing="5">

                                                    <children>

                                                        <Label text="Motivo" />

                                                        <TextArea prefHeight="80" promptText="Describa el motivo..." wrapText="true" />

                                                    </children>

                                                </VBox>

                                                <Button prefHeight="38" prefWidth="260" style="-fx-background-color: transparent;                                                                -fx-border-color: #4B3832;                                                                -fx-border-radius: 6;" text="Aplicar Ajuste" textFill="#4B3832" />

                                            </children>

                                        </VBox>

                                    </children>

                                </VBox>

                            </children>

                        </HBox>

                        <!-- HISTORIAL -->
                        <VBox spacing="15" style="-fx-background-color: white;                                      -fx-background-radius: 10;                                      -fx-border-radius: 10;                                      -fx-border-color: #E5E1DC;                                      -fx-padding: 15;" VBox.vgrow="ALWAYS">

                            <VBox.margin>
                                <Insets bottom="10" left="10" right="10" />
                            </VBox.margin>

                            <children>

                                <Label text="Historial de Movimientos" textFill="#4B3832">

                                    <font>
                                        <Font name="Segoe UI Bold" size="20" />
                                    </font>

                                </Label>

                                <TableView prefHeight="250" VBox.vgrow="ALWAYS">

                                    <columns>

                                        <TableColumn prefWidth="150" text="FECHA" />

                                        <TableColumn prefWidth="190" text="INGREDIENTE" />

                                        <TableColumn prefWidth="120" text="TIPO" />

                                        <TableColumn prefWidth="110" text="CANTIDAD" />

                                        <TableColumn prefWidth="220" text="MOTIVO / PROVEEDOR" />

                                        <TableColumn prefWidth="130" text="USUARIO" />

                                        <TableColumn prefWidth="120" text="ACCIONES" />

                                    </columns>

                                </TableView>

                            </children>

                        </VBox>

                    </children>

                </VBox>

            </content>

        </ScrollPane>

    </center>

</BorderPane>
