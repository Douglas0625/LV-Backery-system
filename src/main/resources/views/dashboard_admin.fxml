<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>



<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity"
            prefHeight="681.0" prefWidth="998.0"
            xmlns="http://javafx.com/javafx/26"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controller.DashboardAdminController">
    <left>
        <VBox prefHeight="678.0" prefWidth="223.0"
              style="-fx-background-color: #4B3832; -fx-padding: 10; -fx-spacing: 15;"
              BorderPane.alignment="CENTER">
            <children>
                <Label alignment="CENTER" contentDisplay="CENTER" prefHeight="27.0" prefWidth="207.0"
                       style="-fx-line-spacing: 10;" text="LV BAKERY" textAlignment="CENTER" textFill="WHITE">
                    <font><Font name="Segoe UI Bold" size="28.0" /></font>
                </Label>
                <Label alignment="CENTER" prefHeight="10.0" prefWidth="202.0"
                       style="-fx-line-spacing: 10;" text="Inventory &amp; management" textFill="#f4d764">
                    <font><Font name="Segoe UI" size="12.0" /></font>
                </Label>

                <!-- DASHBOARD (activo) -->
                <Button alignment="CENTER_LEFT" graphicTextGap="12" mnemonicParsing="false"
                        prefHeight="45.0" prefWidth="200.0"
                        style="-fx-background-color: #6B4F4F; -fx-background-radius: 10; -fx-padding: 10 15 10 15;"
                        text="Dashboard" textFill="WHITE">
                    <graphic><ImageView fitHeight="28.0" fitWidth="28.0" preserveRatio="true">
                        <image><Image url="@../img/panel.png" /></image>
                    </ImageView></graphic>
                    <font><Font name="Segoe UI" size="15.0" /></font>
                    <cursor><Cursor fx:constant="HAND" /></cursor>
                </Button>

                <!-- PEDIDOS -->
                <Button alignment="CENTER_LEFT" graphicTextGap="12" mnemonicParsing="false"
                        prefHeight="45.0" prefWidth="200.0"
                        style="-fx-background-color: transparent; -fx-background-radius: 10; -fx-padding: 10 15 10 15;"
                        text="Pedidos" textFill="WHITE"
                        onAction="#irPedidos">
                    <graphic><ImageView fitHeight="28.0" fitWidth="28.0" preserveRatio="true">
                        <image><Image url="@../img/carrito-de-compras.png" /></image>
                    </ImageView></graphic>
                    <font><Font name="Segoe UI" size="15.0" /></font>
                    <cursor><Cursor fx:constant="HAND" /></cursor>
                </Button>

                <!-- VENTAS -->
                <Button alignment="CENTER_LEFT" graphicTextGap="12" mnemonicParsing="false"
                        prefHeight="45.0" prefWidth="200.0"
                        style="-fx-background-color: transparent; -fx-background-radius: 10; -fx-padding: 10 15 10 15;"
                        text="Ventas" textFill="WHITE"
                        onAction="#irVentas">
                    <graphic><ImageView fitHeight="28.0" fitWidth="28.0" preserveRatio="true">
                        <image><Image url="@../img/dinero.png" /></image>
                    </ImageView></graphic>
                    <font><Font name="Segoe UI" size="15.0" /></font>
                    <cursor><Cursor fx:constant="HAND" /></cursor>
                </Button>

                <!-- RECETAS -->
                <Button alignment="CENTER_LEFT" graphicTextGap="12" mnemonicParsing="false"
                        prefHeight="45.0" prefWidth="200.0"
                        style="-fx-background-color: transparent; -fx-background-radius: 10; -fx-padding: 10 15 10 15;"
                        text="Recetas" textFill="WHITE"
                        onAction="#irRecetas">
                    <graphic><ImageView fitHeight="28.0" fitWidth="28.0" preserveRatio="true">
                        <image><Image url="@../img/libro.png" /></image>
                    </ImageView></graphic>
                    <font><Font name="Segoe UI" size="15.0" /></font>
                    <cursor><Cursor fx:constant="HAND" /></cursor>
                </Button>

                <!-- REPORTES -->
                <Button alignment="CENTER_LEFT" graphicTextGap="12" mnemonicParsing="false"
                        prefHeight="45.0" prefWidth="200.0"
                        style="-fx-background-color: transparent; -fx-background-radius: 10; -fx-padding: 10 15 10 15;"
                        text="Reportes" textFill="WHITE"
                        onAction="#irReportes">
                    <graphic><ImageView fitHeight="28.0" fitWidth="28.0" preserveRatio="true">
                        <image><Image url="@../img/grafico-de-barras.png" /></image>
                    </ImageView></graphic>
                    <font><Font name="Segoe UI" size="15.0" /></font>
                    <cursor><Cursor fx:constant="HAND" /></cursor>
                </Button>

                <!-- INVENTARIO -->
                <Button alignment="CENTER_LEFT" graphicTextGap="12" mnemonicParsing="false"
                        prefHeight="45.0" prefWidth="200.0"
                        style="-fx-background-color: transparent; -fx-background-radius: 10; -fx-padding: 10 15 10 15;"
                        text="Inventario" textFill="WHITE"
                        onAction="#irInventario">
                    <graphic><ImageView fitHeight="28.0" fitWidth="28.0" preserveRatio="true">
                        <image><Image url="@../img/contenedor-de-comida.png" /></image>
                    </ImageView></graphic>
                    <font><Font name="Segoe UI" size="15.0" /></font>
                    <cursor><Cursor fx:constant="HAND" /></cursor>
                </Button>

                <!-- USUARIOS -->
                <Button alignment="CENTER_LEFT" graphicTextGap="12" mnemonicParsing="false"
                        prefHeight="45.0" prefWidth="200.0"
                        style="-fx-background-color: transparent; -fx-background-radius: 10; -fx-padding: 10 15 10 15;"
                        text="Usuarios" textFill="WHITE"
                        onAction="#irUsuarios">
                    <graphic><ImageView fitHeight="28.0" fitWidth="28.0" preserveRatio="true">
                        <image><Image url="@../img/usuario.png" /></image>
                    </ImageView></graphic>
                    <font><Font name="Segoe UI" size="15.0" /></font>
                    <cursor><Cursor fx:constant="HAND" /></cursor>
                </Button>
            </children>
        </VBox>
    </left>
    <center>
        <VBox prefHeight="685.0" prefWidth="866.0" spacing="0"
              style="-fx-background-color: #F5F3EF;" BorderPane.alignment="CENTER">
            <children>
                <!-- TOPBAR -->
                <HBox alignment="CENTER" prefHeight="55.0" prefWidth="597.0"
                      style="-fx-border-color: #4B3832; -fx-border-width: 2; -fx-background-color: #F5F3EF;">
                    <children>
                        <Label prefHeight="50.0" prefWidth="147.0" text="Bakery Manager" textFill="#4b3832">
                            <font><Font name="System Bold" size="18.0" /></font>
                            <padding><Insets left="5.0" /></padding>
                        </Label>
                        <Region prefHeight="55.0" prefWidth="300.0" HBox.hgrow="ALWAYS" />
                        <!-- nombre usuario dinámico -->
                        <Label fx:id="lblNombreUsuario" prefHeight="15.0" prefWidth="120.0"
                               text="Admin" textFill="#4b3832">
                            <font><Font name="Segoe UI" size="12.0" /></font>
                        </Label>
                        <Button mnemonicParsing="false" prefHeight="26.0" prefWidth="46.0"
                                style="-fx-background-color: transparent;">
                            <graphic><ImageView fitHeight="23.0" fitWidth="25.0" pickOnBounds="true" preserveRatio="true">
                                <image><Image url="@../img/avatar.png" /></image>
                            </ImageView></graphic>
                            <cursor><Cursor fx:constant="HAND" /></cursor>
                        </Button>
                        <!-- Botón cerrar sesión -->
                        <Button mnemonicParsing="false" prefHeight="26.0" prefWidth="46.0"
                                style="-fx-background-color: transparent;"
                                onAction="#cerrarSesion">
                            <graphic><ImageView fitHeight="23.0" fitWidth="25.0" pickOnBounds="true" preserveRatio="true">
                                <image><Image url="@../img/cerrar-sesion.png" /></image>
                            </ImageView></graphic>
                            <cursor><Cursor fx:constant="HAND" /></cursor>
                        </Button>
                    </children>
                </HBox>

                <!-- BIENVENIDA + ACCESOS RÁPIDOS -->
                <HBox alignment="CENTER" prefHeight="125.0" prefWidth="597.0"
                      style="-fx-background-color: white;">
                    <VBox.margin><Insets bottom="10.0" left="10.0" right="10.0" top="10.0" /></VBox.margin>
                    <children>
                        <VBox alignment="CENTER_LEFT" prefHeight="126.0" prefWidth="386.0">
                            <children>
                                <Label alignment="CENTER" prefHeight="50.0" prefWidth="261.0"
                                       text="Bienvenido, Administrador" textFill="#4b3832">
                                    <font><Font name="Segoe UI Bold" size="20.0" /></font>
                                </Label>
                                <Label prefHeight="18.0" prefWidth="379.0"
                                       text="Aquí tienes el resumen de la actividad de hoy en la panadería artesanal." />
                            </children>
                        </VBox>
                        <Region prefHeight="200.0" prefWidth="200.0" HBox.hgrow="ALWAYS" />
                        <Button mnemonicParsing="false" prefHeight="26.0" prefWidth="134.0"
                                style="-fx-background-color: #4b3832;" text="Nuevo Pedido" textFill="WHITE"
                                onAction="#irPedidos">
                            <cursor><Cursor fx:constant="HAND" /></cursor>
                            <font><Font name="Segoe UI Bold" size="12.0" /></font>
                        </Button>
                        <Button mnemonicParsing="false" prefHeight="28.0" prefWidth="146.0"
                                style="-fx-background-color: transparent; -fx-border-color: #4b3832;"
                                text="Registrar venta" textFill="#4b3832"
                                onAction="#irVentas">
                            <cursor><Cursor fx:constant="HAND" /></cursor>
                            <HBox.margin><Insets left="10.0" right="10.0" /></HBox.margin>
                            <font><Font name="Segoe UI Bold" size="12.0" /></font>
                        </Button>
                    </children>
                </HBox>

                <!-- CARDS ESTADÍSTICAS -->
                <HBox prefHeight="160.0" prefWidth="820.0" spacing="15">
                    <VBox.margin><Insets left="10.0" right="10.0" /></VBox.margin>
                    <children>

                        <!-- CARD 1: Pedidos Pendientes -->
                        <VBox prefHeight="140.0" prefWidth="220.0"
                              style="-fx-background-color: white; -fx-background-radius: 10; -fx-border-radius: 10; -fx-padding: 20; -fx-border-color: #E5E1DC;">
                            <children>
                                <HBox alignment="CENTER_LEFT">
                                    <children>
                                        <Label text="PEDIDOS PENDIENTES" textFill="#7A6F68">
                                            <font><Font name="Segoe UI Bold" size="11.0" /></font>
                                        </Label>
                                        <Region HBox.hgrow="ALWAYS" />
                                    </children>
                                </HBox>
                                <Label fx:id="lblPedidosPendientes" text="—" textFill="#4B3832">
                                    <font><Font name="Segoe UI Bold" size="36.0" /></font>
                                    <VBox.margin><Insets top="10.0" /></VBox.margin>
                                </Label>
                                <Label text="pedidos activos" textFill="#7A6F68">
                                    <font><Font name="Segoe UI" size="12.0" /></font>
                                </Label>
                            </children>
                        </VBox>

                        <!-- CARD 2: Ventas del día -->
                        <VBox prefHeight="140.0" prefWidth="220.0"
                              style="-fx-background-color: white; -fx-background-radius: 10; -fx-border-radius: 10; -fx-padding: 20; -fx-border-color: #E5E1DC;">
                            <children>
                                <HBox alignment="CENTER_LEFT">
                                    <children>
                                        <Label text="VENTAS DEL DÍA" textFill="#7A6F68">
                                            <font><Font name="Segoe UI Bold" size="11.0" /></font>
                                        </Label>
                                        <Region HBox.hgrow="ALWAYS" />
                                    </children>
                                </HBox>
                                <Label fx:id="lblTotalVentasHoy" text="\$0.00" textFill="#4B3832">
                                    <font><Font name="Segoe UI Bold" size="28.0" /></font>
                                    <VBox.margin><Insets top="10.0" /></VBox.margin>
                                </Label>
                                <Label fx:id="lblCantidadVentasHoy" text="0 ventas" textFill="#3FAE5A">
                                    <font><Font name="Segoe UI" size="12.0" /></font>
                                </Label>
                            </children>
                        </VBox>

                        <!-- CARD 3: Stock Bajo -->
                        <VBox prefHeight="140.0" prefWidth="220.0"
                              style="-fx-background-color: white; -fx-background-radius: 10; -fx-border-radius: 10; -fx-padding: 20; -fx-border-color: #E5E1DC;">
                            <children>
                                <HBox alignment="CENTER_LEFT">
                                    <children>
                                        <Label text="STOCK BAJO" textFill="#7A6F68">
                                            <font><Font name="Segoe UI Bold" size="11.0" /></font>
                                        </Label>
                                        <Region HBox.hgrow="ALWAYS" />
                                    </children>
                                </HBox>
                                <Label fx:id="lblStockCritico" text="—" textFill="#D64545">
                                    <font><Font name="Segoe UI Bold" size="32.0" /></font>
                                    <VBox.margin><Insets top="10.0" /></VBox.margin>
                                </Label>
                            </children>
                        </VBox>

                    </children>
                </HBox>

                <!-- SECCIÓN INFERIOR: Pedidos recientes + Movimientos -->
                <HBox spacing="15" VBox.vgrow="ALWAYS">
                    <VBox.margin><Insets bottom="10.0" left="10.0" right="10.0" top="10.0" /></VBox.margin>
                    <children>

                        <!-- TABLA PEDIDOS RECIENTES -->
                        <VBox prefWidth="520.0" spacing="10"
                              style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 15; -fx-border-color: #E5E1DC; -fx-border-radius: 10;"
                              HBox.hgrow="ALWAYS">
                            <children>
                                <HBox alignment="CENTER_LEFT">
                                    <children>
                                        <Label text="Últimos Pedidos" textFill="#4B3832">
                                            <font><Font name="Segoe UI Bold" size="18.0" /></font>
                                        </Label>
                                        <Region HBox.hgrow="ALWAYS" />
                                        <Button mnemonicParsing="false"
                                                style="-fx-background-color: transparent;" text="Ver todo" textFill="#8B5E3C"
                                                onAction="#irPedidos">
                                            <font><Font name="Segoe UI Bold" size="12.0" /></font>
                                            <cursor><Cursor fx:constant="HAND" /></cursor>
                                        </Button>
                                    </children>
                                </HBox>
                                <TableView fx:id="tablaPedidosRecientes" prefHeight="300.0"
                                           style="-fx-background-color: white;" VBox.vgrow="ALWAYS">
                                    <columns>
                                        <TableColumn fx:id="colIdPedidoD" prefWidth="80.0" text="PEDIDO #" />
                                        <TableColumn fx:id="colClienteD" prefWidth="160.0" text="CLIENTE" />
                                        <TableColumn fx:id="colEstadoD" prefWidth="140.0" text="ESTADO" />
                                        <TableColumn fx:id="colTotalD" prefWidth="100.0" text="TOTAL" />
                                    </columns>
                                </TableView>
                            </children>
                        </VBox>

                        <!-- TABLA MOVIMIENTOS RECIENTES -->
                        <VBox prefWidth="350.0" spacing="10"
                              style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 15; -fx-border-color: #E5E1DC; -fx-border-radius: 10;"
                              HBox.hgrow="ALWAYS">
                            <children>
                                <Label text="Últimos Movimientos" textFill="#4B3832">
                                    <font><Font name="Segoe UI Bold" size="18.0" /></font>
                                </Label>
                                <TableView fx:id="tablaMovimientos" prefHeight="300.0"
                                           style="-fx-background-color: white;" VBox.vgrow="ALWAYS">
                                    <columns>
                                        <TableColumn fx:id="colFechaMov" prefWidth="80.0" text="FECHA" />
                                        <TableColumn fx:id="colIngredienteMov" prefWidth="130.0" text="INGREDIENTE" />
                                        <TableColumn fx:id="colTipoMov" prefWidth="100.0" text="TIPO" />
                                    </columns>
                                </TableView>
                            </children>
                        </VBox>

                    </children>
                </HBox>

            </children>
        </VBox>
    </center>
</BorderPane>
