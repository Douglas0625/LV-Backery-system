<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane style="-fx-background-color: #F5F3EF;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="controller.RecetasController">

    <!-- ================= CONTENIDO ================= -->

    <center>

        <ScrollPane fitToHeight="true" fitToWidth="true" pannable="true" style="-fx-background: #F5F3EF;">

            <content>
      
                <VBox spacing="20">
      
                    <children>
      
                        <!-- HEADER -->
      
                        <HBox alignment="CENTER_LEFT">
      
                            <children>
      
                                <VBox spacing="5">
      
                                    <children>
      
                                        <Label text="Gestión de Productos y Recetas" textFill="#3E2C27">
      
                                            <font>
                                                <Font name="Segoe UI Bold" size="30" />
                                            </font>
      
                                        </Label>
      
                                        <Label text="Administre productos, recetas e ingredientes" textFill="#7A6E69">
      
                                            <font>
                                                <Font name="Segoe UI" size="14" />
                                            </font>
      
                                        </Label>
      
                                    </children>
      
                                </VBox>
      
                                <Region HBox.hgrow="ALWAYS" />
      
                                <Button prefHeight="42" prefWidth="180" style="-fx-background-color: #D8B08C;                                                -fx-text-fill: white;                                                -fx-font-weight: bold;                                                -fx-background-radius: 8;" text="+ Nuevo Producto">
      
                                    <font>
                                        <Font name="Segoe UI Bold" size="14" />
                                    </font>
      
                                </Button>
      
                            </children>
                     <VBox.margin>
                        <Insets left="25.0" right="25.0" />
                     </VBox.margin>
      
                        </HBox>
      
                        <!-- CONTENIDO PRINCIPAL -->
      
                        <HBox spacing="20">
      
                            <children>
      
                                <!-- TABLA PRODUCTOS -->
      
                                <VBox spacing="10" style="-fx-background-color: white;                                              -fx-padding: 20;                                              -fx-background-radius: 15;" HBox.hgrow="ALWAYS">
      
                                    <children>
      
                                        <HBox alignment="CENTER_LEFT">
      
                                            <children>
      
                                                <Label text="Productos Registrados" textFill="#3E2C27">
      
                                                    <font>
                                                        <Font name="Segoe UI Bold" size="22" />
                                                    </font>
      
                                                </Label>
      
                                                <Region HBox.hgrow="ALWAYS" />
      
                                                <TextField prefWidth="220" promptText="Buscar producto..." />
      
                                            </children>
      
                                        </HBox>
      
                                        <!-- TABLA -->
      
                                        <TableView prefHeight="600" VBox.vgrow="ALWAYS">
      
                                            <columns>
      
                                                <TableColumn prefWidth="220" text="PRODUCTO" />
      
                                                <TableColumn prefWidth="100" text="PRECIO" />
      
                                                <TableColumn prefWidth="120" text="COSTO" />
      
                                                <TableColumn prefWidth="130" text="RENDIMIENTO" />
      
                                                <TableColumn prefWidth="100" text="ACCIÓN" />
      
                                            </columns>
      
                                        </TableView>
      
                                    </children>
      
                                </VBox>
      
                                <!-- PANEL DERECHO -->
      
                                <VBox maxWidth="420" minWidth="420" prefWidth="420" spacing="18">
      
                                    <children>
      
                                        <!-- RECETA -->
      
                                        <VBox spacing="15" style="-fx-background-color: white;                                                      -fx-padding: 20;                                                      -fx-background-radius: 15;">
      
                                            <children>
      
                                                <Label text="Detalle de Receta" textFill="#3E2C27">
      
                                                    <font>
                                                        <Font name="Segoe UI Bold" size="22" />
                                                    </font>
      
                                                </Label>
      
                                                <!-- PRODUCTO -->
      
                                                <VBox spacing="6">
      
                                                    <children>
      
                                                        <Label text="Producto" />
      
                                                        <TextField promptText="Ej: Cheesecake" />
      
                                                    </children>
      
                                                </VBox>
      
                                                <!-- DESCRIPCION -->
      
                                                <VBox spacing="6">
      
                                                    <children>
      
                                                        <Label text="Descripción" />
      
                                                        <TextArea prefHeight="80" promptText="Descripción del producto" wrapText="true" />
      
                                                    </children>
      
                                                </VBox>
      
                                                <!-- PRECIOS -->
      
                                                <HBox spacing="10">
      
                                                    <children>
      
                                                        <VBox spacing="6">
      
                                                            <children>
      
                                                                <Label text="Precio Venta" />
      
                                                                <TextField prefWidth="140" promptText="0.00" />
      
                                                            </children>
      
                                                        </VBox>
      
                                                        <VBox spacing="6">
      
                                                            <children>
      
                                                                <Label text="Rendimiento" />
      
                                                                <TextField prefWidth="140" promptText="12" />
      
                                                            </children>
      
                                                        </VBox>
      
                                                    </children>
      
                                                </HBox>
      
                                                <!-- TABLA INGREDIENTES -->
      
                                                <VBox spacing="10">
      
                                                    <children>
      
                                                        <HBox alignment="CENTER_LEFT">
      
                                                            <children>
      
                                                                <Label text="Ingredientes" textFill="#8B4A2F">
      
                                                                    <font>
                                                                        <Font name="Segoe UI Bold" size="18" />
                                                                    </font>
      
                                                                </Label>
      
                                                                <Region HBox.hgrow="ALWAYS" />
      
                                                                <Button prefHeight="35" prefWidth="130" style="-fx-background-color: #D8B08C;                                                                                -fx-text-fill: white;                                                                                -fx-font-weight: bold;" text="+ Ingrediente" />
      
                                                            </children>
      
                                                        </HBox>
      
                                                        <TableView prefHeight="260">
      
                                                            <columns>
      
                                                                <TableColumn prefWidth="170" text="INGREDIENTE" />
      
                                                                <TableColumn prefWidth="90" text="GRAMOS" />
      
                                                                <TableColumn prefWidth="80" text="COSTO" />
      
                                                                <TableColumn prefWidth="60" text="ACC." />
      
                                                            </columns>
      
                                                        </TableView>
      
                                                    </children>
      
                                                </VBox>
      
                                                <!-- COSTO -->
      
                                                <VBox spacing="5" style="-fx-background-color: #F2A47F;                                                              -fx-padding: 15;                                                              -fx-background-radius: 10;">
      
                                                    <children>
      
                                                        <Label text="COSTO ESTIMADO" textFill="#8A4B32">
      
                                                            <font>
                                                                <Font name="Segoe UI Bold" size="12" />
                                                            </font>
      
                                                        </Label>
      
                                                        <Label text="\$1.24 / unidad" textFill="#4B3832">
      
                                                            <font>
                                                                <Font name="Segoe UI Bold" size="28" />
                                                            </font>
      
                                                        </Label>
      
                                                    </children>
      
                                                </VBox>
      
                                                <!-- BOTONES -->
      
                                                <HBox spacing="12">
      
                                                    <children>
      
                                                        <Button prefHeight="42" prefWidth="180" style="-fx-background-color: transparent;                                                                        -fx-border-color: #3E2A24;                                                                        -fx-border-radius: 8;                                                                        -fx-background-radius: 8;                                                                        -fx-font-weight: bold;" text="Limpiar" />
      
                                                        <Button prefHeight="42" prefWidth="180" style="-fx-background-color: #3E2A24;                                                                        -fx-text-fill: white;                                                                        -fx-font-weight: bold;                                                                        -fx-background-radius: 8;" text="Guardar" />
      
                                                    </children>
      
                                                </HBox>
      
                                            </children>
      
                                        </VBox>
      
                                    </children>
      
                                </VBox>
      
                            </children>
                     <VBox.margin>
                        <Insets left="25.0" right="25.0" />
                     </VBox.margin>
      
                        </HBox>
      
                    </children>
      
                </VBox>

            </content>

        </ScrollPane>

    </center>

</BorderPane>
