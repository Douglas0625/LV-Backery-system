<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="420" prefWidth="440" spacing="16"
      xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controller.IngredienteModalController"
      style="-fx-background-color: white; -fx-padding: 25; -fx-background-radius: 12;">

    <Label fx:id="lblTitulo" text="Nuevo Ingrediente" textFill="#4B3832">
        <font><Font name="Segoe UI Bold" size="22"/></font>
    </Label>

    <Separator/>

    <!-- NOMBRE -->
    <VBox spacing="5">
        <Label text="Nombre del Ingrediente">
            <font><Font name="Segoe UI Bold" size="12"/></font>
        </Label>
        <TextField fx:id="txtNombre" prefHeight="38" maxWidth="Infinity"
                   promptText="Ej: Harina de trigo"
                   style="-fx-background-color:#F0EFEB; -fx-border-color:#E5E1D8; -fx-border-radius:4; -fx-background-radius:4;"/>
    </VBox>

    <!-- STOCK INICIAL Y COSTO -->
    <HBox spacing="12">
        <VBox spacing="5" HBox.hgrow="ALWAYS">
            <Label text="Stock inicial (gramos)">
                <font><Font name="Segoe UI Bold" size="12"/></font>
            </Label>
            <TextField fx:id="txtStock" prefHeight="38" maxWidth="Infinity"
                       promptText="0"
                       style="-fx-background-color:#F0EFEB; -fx-border-color:#E5E1D8; -fx-border-radius:4; -fx-background-radius:4;"/>
        </VBox>
        <VBox spacing="5" HBox.hgrow="ALWAYS">
            <Label text="Costo por gramo ($)">
                <font><Font name="Segoe UI Bold" size="12"/></font>
            </Label>
            <TextField fx:id="txtCostoGramo" prefHeight="38" maxWidth="Infinity"
                       promptText="0.0000"
                       style="-fx-background-color:#F0EFEB; -fx-border-color:#E5E1D8; -fx-border-radius:4; -fx-background-radius:4;"/>
        </VBox>
    </HBox>

    <!-- INFO CALCULADA -->
    <VBox spacing="6"
          style="-fx-background-color:#F9F7F5; -fx-border-color:#E5E1DC;
                 -fx-border-radius:8; -fx-background-radius:8; -fx-padding:12;">
        <HBox spacing="8">
            <Label text="Valor inventario:" textFill="#666" style="-fx-font-size:12px;"/>
            <Label fx:id="lblValorInventario" text="\$0.00" textFill="#4B3832">
                <font><Font name="Segoe UI Bold" size="12"/></font>
            </Label>
        </HBox>
    </VBox>

    <Region VBox.vgrow="ALWAYS"/>

    <!-- BOTONES -->
    <HBox alignment="CENTER_RIGHT" spacing="12">
        <Button prefHeight="42" prefWidth="120" text="Cancelar"
                onAction="#cancelar"
                style="-fx-background-color:white; -fx-border-color:#4B3832;
                       -fx-border-radius:8; -fx-background-radius:8; -fx-font-size:13px;">
            <cursor><Cursor fx:constant="HAND"/></cursor>
        </Button>
        <Button fx:id="btnGuardar" prefHeight="42" prefWidth="140" text="Guardar"
                onAction="#guardar"
                style="-fx-background-color:#4B3832; -fx-text-fill:white;
                       -fx-background-radius:8; -fx-font-size:13px; -fx-font-weight:bold;">
            <cursor><Cursor fx:constant="HAND"/></cursor>
        </Button>
    </HBox>

</VBox>
