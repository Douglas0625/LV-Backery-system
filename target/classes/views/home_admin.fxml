<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<ScrollPane fitToWidth="true" fitToHeight="false"
            style="-fx-background-color: transparent; -fx-background: transparent;"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controller.HomeAdminController">

    <content>
    <VBox spacing="0" style="-fx-background-color: #F5F3EF;">
        <padding><Insets top="0" left="0" right="0" bottom="20"/></padding>

        <!-- BANNER DE BIENVENIDA -->
        <HBox alignment="CENTER_LEFT" prefHeight="100"
              style="-fx-background-color: white; -fx-border-color: #E5E1DC; -fx-border-width: 0 0 1 0;">
            <padding><Insets left="25" right="25"/></padding>
            <children>
                <VBox alignment="CENTER_LEFT" spacing="5">
                    <children>
                        <Label fx:id="lblBienvenida" text="Bienvenido, Administrador" textFill="#4B3832">
                            <font><Font name="Segoe UI Bold" size="22"/></font>
                        </Label>
                        <Label text="Aquí tienes el resumen de actividad de hoy." textFill="#7A6F68">
                            <font><Font name="Segoe UI" size="13"/></font>
                        </Label>
                    </children>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="+ Nuevo Pedido" textFill="WHITE"
                        onAction="#irPedidos"
                        style="-fx-background-color: #4B3832; -fx-background-radius: 6; -fx-padding: 8 20 8 20;">
                    <font><Font name="Segoe UI Bold" size="13"/></font>
                    <cursor><Cursor fx:constant="HAND"/></cursor>
                </Button>
                <Button text="Registrar Venta" textFill="#4B3832"
                        onAction="#irVentas"
                        style="-fx-background-color: transparent; -fx-border-color: #4B3832; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 8 20 8 20;">
                    <HBox.margin><Insets left="12"/></HBox.margin>
                    <font><Font name="Segoe UI Bold" size="13"/></font>
                    <cursor><Cursor fx:constant="HAND"/></cursor>
                </Button>
            </children>
        </HBox>

        <!-- CARDS ESTADISTICAS -->
        <HBox spacing="15">
            <VBox.margin><Insets top="20" left="20" right="20"/></VBox.margin>
            <children>

                <!-- CARD PEDIDOS PENDIENTES -->
                <VBox spacing="8" HBox.hgrow="ALWAYS"
                      style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 20; -fx-border-color: #E5E1DC; -fx-border-radius: 10;">
                    <children>
                        <HBox alignment="CENTER_LEFT">
                            <children>
                                <Label text="PEDIDOS PENDIENTES" textFill="#7A6F68">
                                    <font><Font name="Segoe UI Bold" size="11"/></font>
                                </Label>
                                <Region HBox.hgrow="ALWAYS"/>
                                <ImageView fitWidth="18" fitHeight="18" preserveRatio="true">
                                    <image><Image url="@../img/variante-de-portapapeles-con-listas-y-cheques.png"/></image>
                                </ImageView>
                            </children>
                        </HBox>
                        <Label fx:id="lblPedidosPendientes" text="0" textFill="#4B3832">
                            <font><Font name="Segoe UI Bold" size="36"/></font>
                        </Label>
                        <Region prefHeight="4" maxWidth="Infinity"
                                style="-fx-background-color: #8B5E3C; -fx-background-radius: 10;"/>
                    </children>
                </VBox>

                <!-- CARD VENTAS DEL DIA -->
                <VBox spacing="8" HBox.hgrow="ALWAYS"
                      style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 20; -fx-border-color: #E5E1DC; -fx-border-radius: 10;">
                    <children>
                        <HBox alignment="CENTER_LEFT">
                            <children>
                                <Label text="VENTAS DEL DÍA" textFill="#7A6F68">
                                    <font><Font name="Segoe UI Bold" size="11"/></font>
                                </Label>
                                <Region HBox.hgrow="ALWAYS"/>
                                <ImageView fitWidth="18" fitHeight="18" preserveRatio="true">
                                    <image><Image url="@../img/billete-de-un-dolar.png"/></image>
                                </ImageView>
                            </children>
                        </HBox>
                        <Label fx:id="lblVentasDia" text="\$0.00" textFill="#4B3832">
                            <font><Font name="Segoe UI Bold" size="30"/></font>
                        </Label>
                        <Label fx:id="lblCantVentas" text="0 ventas" textFill="#3FAE5A">
                            <font><Font name="Segoe UI" size="12"/></font>
                        </Label>
                    </children>
                </VBox>

                <!-- CARD STOCK BAJO -->
                <VBox spacing="8" HBox.hgrow="ALWAYS"
                      style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 20; -fx-border-color: #E5E1DC; -fx-border-radius: 10;">
                    <children>
                        <HBox alignment="CENTER_LEFT">
                            <children>
                                <Label text="STOCK BAJO" textFill="#7A6F68">
                                    <font><Font name="Segoe UI Bold" size="11"/></font>
                                </Label>
                                <Region HBox.hgrow="ALWAYS"/>
                                <ImageView fitWidth="18" fitHeight="18" preserveRatio="true">
                                    <image><Image url="@../img/peligro.png"/></image>
                                </ImageView>
                            </children>
                        </HBox>
                        <HBox alignment="BOTTOM_LEFT" spacing="5">
                            <children>
                                <Label fx:id="lblStockBajo" text="0" textFill="#D64545">
                                    <font><Font name="Segoe UI Bold" size="36"/></font>
                                </Label>
                                <Label text="ingredientes" textFill="#4B3832" VBox.vgrow="ALWAYS">
                                    <font><Font name="Segoe UI" size="13"/></font>
                                    <HBox.margin><Insets bottom="8"/></HBox.margin>
                                </Label>
                            </children>
                        </HBox>
                    </children>
                </VBox>

                <!-- CARD PRODUCTO TOP -->
                <VBox spacing="8" HBox.hgrow="ALWAYS"
                      style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 20; -fx-border-color: #E5E1DC; -fx-border-radius: 10;">
                    <children>
                        <HBox alignment="CENTER_LEFT">
                            <children>
                                <Label text="PRODUCTO TOP" textFill="#7A6F68">
                                    <font><Font name="Segoe UI Bold" size="11"/></font>
                                </Label>
                                <Region HBox.hgrow="ALWAYS"/>
                                <ImageView fitWidth="18" fitHeight="18" preserveRatio="true">
                                    <image><Image url="@../img/libro.png"/></image>
                                </ImageView>
                            </children>
                        </HBox>
                        <Label fx:id="lblProductoTop" text="—" textFill="#4B3832" wrapText="true">
                            <font><Font name="Segoe UI Bold" size="24"/></font>
                        </Label>
                        <Label fx:id="lblProductoTopVentas" text="" textFill="#D89B00">
                            <font><Font name="Segoe UI" size="12"/></font>
                        </Label>
                    </children>
                </VBox>

            </children>
        </HBox>

        <!-- SECCION INFERIOR: TABLA PEDIDOS + MOVIMIENTOS -->
        <HBox spacing="15" VBox.vgrow="ALWAYS">
            <VBox.margin><Insets top="20" left="20" right="20" bottom="10"/></VBox.margin>
            <children>

                <!-- TABLA ULTIMOS PEDIDOS -->
                <VBox spacing="12" HBox.hgrow="ALWAYS"
                      style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 18; -fx-border-color: #E5E1DC; -fx-border-radius: 10;">
                    <children>
                        <HBox alignment="CENTER_LEFT">
                            <children>
                                <Label text="Últimos Pedidos" textFill="#4B3832">
                                    <font><Font name="Segoe UI Bold" size="18"/></font>
                                </Label>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Button text="Ver todo" textFill="#8B5E3C" onAction="#irPedidos"
                                        style="-fx-background-color: transparent;">
                                    <font><Font name="Segoe UI Bold" size="12"/></font>
                                    <cursor><Cursor fx:constant="HAND"/></cursor>
                                </Button>
                            </children>
                        </HBox>
                        <TableView fx:id="tablaUltimosPedidos" prefHeight="260" VBox.vgrow="ALWAYS"
                                   style="-fx-background-color: white;">
                            <columns>
                                <TableColumn fx:id="colPedidoId"     text="PEDIDO #"  prefWidth="90"/>
                                <TableColumn fx:id="colPedidoCliente" text="CLIENTE"  prefWidth="170"/>
                                <TableColumn fx:id="colPedidoEstado" text="ESTADO"    prefWidth="130"/>
                                <TableColumn fx:id="colPedidoTotal"  text="TOTAL"     prefWidth="110"/>
                            </columns>
                        </TableView>
                    </children>
                </VBox>

                <!-- ULTIMOS MOVIMIENTOS -->
                <VBox spacing="12" prefWidth="300" minWidth="260"
                      style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 18; -fx-border-color: #E5E1DC; -fx-border-radius: 10;">
                    <children>
                        <Label text="Últimos Movimientos" textFill="#4B3832">
                            <font><Font name="Segoe UI Bold" size="18"/></font>
                        </Label>
                        <VBox fx:id="contenedorMovimientos" spacing="8"/>
                    </children>
                </VBox>

            </children>
        </HBox>

    </VBox>
    </content>
</ScrollPane>
