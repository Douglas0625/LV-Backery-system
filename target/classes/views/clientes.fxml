<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<ScrollPane fitToHeight="false" fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.ClientesController">
<content>
<VBox spacing="15" style="-fx-background-color: #F5F3EF;">
    <padding><Insets bottom="20" left="20" right="20" top="20" /></padding>
         <Label text="Gestion de Clientes" textFill="#4B3832">
            <font>
               <Font name="Segoe UI Bold" size="24.0" />
            </font>
         </Label>
         <Label style="-fx-text-fill: black;" text="Acciones CRUD completos para clientes de la panaderia" />

    <!-- CARD RESUMEN -->
    <HBox spacing="15">
        <VBox spacing="8" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 10; -fx-border-radius: 10; -fx-border-color: #E5E1DC;" HBox.hgrow="ALWAYS">
            <Label text="TOTAL CLIENTES" textFill="#7A6F68">
                <font><Font name="Segoe UI Bold" size="11" /></font>
            </Label>
            <Label fx:id="lblTotal" text="0" textFill="#4B3832">
                <font><Font name="Segoe UI Bold" size="34" /></font>
            </Label>
        </VBox>
    </HBox>

    <!-- TABLA -->
    <VBox spacing="12" style="-fx-background-color: white; -fx-background-radius: 10; -fx-border-radius: 10; -fx-border-color: #E5E1DC; -fx-padding: 18;" VBox.vgrow="ALWAYS">

        <HBox alignment="CENTER_LEFT" spacing="10">
            <Label text="Clientes" textFill="#4B3832">
                <font><Font name="Segoe UI Bold" size="18.0" /></font>
            </Label>
            <Region HBox.hgrow="ALWAYS" />
            <TextField fx:id="txtBuscar" prefHeight="34" prefWidth="240" promptText="Buscar por nombre o correo..." style="-fx-background-color: #F5F3EF; -fx-border-color: #E5E1D8; -fx-border-radius: 5; -fx-background-radius: 5;" />
        </HBox>

        <TableView fx:id="tablaClientes" prefHeight="300" style="-fx-background-color: white;" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colId" prefWidth="60" text="ID" />
                <TableColumn fx:id="colNombre" prefWidth="260" text="NOMBRE" />
                <TableColumn fx:id="colTelefono" prefWidth="160" text="TELÉFONO" />
                <TableColumn fx:id="colCorreo" prefWidth="280" text="CORREO" />
            </columns>
        </TableView>

        <HBox alignment="CENTER_RIGHT">
            <Button onAction="#eliminarCliente" style="-fx-background-color: #C0392B; -fx-background-radius: 6; -fx-padding: 8 16 8 16;" text="Eliminar Seleccionado" textFill="WHITE">
                <font><Font name="Segoe UI Bold" size="12" /></font>
                <cursor><Cursor fx:constant="HAND" /></cursor>
            </Button>
        </HBox>
    </VBox>

    <!-- FORMULARIOS LADO A LADO -->
    <HBox spacing="15">

        <!-- CREAR -->
        <VBox spacing="14" style="-fx-background-color: white; -fx-background-radius: 10; -fx-border-radius: 10; -fx-border-color: #E5E1DC; -fx-padding: 20;" HBox.hgrow="ALWAYS">

            <Label text="Crear Cliente" textFill="#4B3832">
                <font><Font name="Segoe UI Bold" size="18" /></font>
            </Label>

            <VBox spacing="4">
                <Label prefHeight="15.0" prefWidth="128.0" style="-fx-text-fill: black;" text="Nombre completo"><font><Font name="Segoe UI Bold" size="12" /></font></Label>
                <TextField fx:id="txtNombreCrear" prefHeight="34" style="-fx-background-color: #F0EFEB; -fx-border-color: #E5E1D8; -fx-border-radius: 4; -fx-background-radius: 4;" />
            </VBox>

            <VBox spacing="4">
                <Label style="-fx-text-fill: black;" text="Teléfono"><font><Font name="Segoe UI Bold" size="12" /></font></Label>
                <TextField fx:id="txtTelefonoCrear" prefHeight="34" style="-fx-background-color: #F0EFEB; -fx-border-color: #E5E1D8; -fx-border-radius: 4; -fx-background-radius: 4;" />
            </VBox>

            <VBox spacing="4">
                <Label style="-fx-text-fill: black;" text="Correo electrónico"><font><Font name="Segoe UI Bold" size="12" /></font></Label>
                <TextField fx:id="txtCorreoCrear" prefHeight="34" style="-fx-background-color: #F0EFEB; -fx-border-color: #E5E1D8; -fx-border-radius: 4; -fx-background-radius: 4;" />
            </VBox>

            <HBox alignment="CENTER_RIGHT">
                <Button onAction="#crearCliente" prefHeight="38" prefWidth="160" style="-fx-background-color: #4B3832; -fx-background-radius: 6;" text="Crear Cliente" textFill="WHITE">
                    <font><Font name="Segoe UI Bold" size="13" /></font>
                    <cursor><Cursor fx:constant="HAND" /></cursor>
                </Button>
            </HBox>
        </VBox>

        <!-- EDITAR -->
        <VBox spacing="14" style="-fx-background-color: white; -fx-background-radius: 10; -fx-border-radius: 10; -fx-border-color: #E5E1DC; -fx-padding: 20;" HBox.hgrow="ALWAYS">

            <Label text="Editar Cliente Seleccionado" textFill="#4B3832">
                <font><Font name="Segoe UI Bold" size="18" /></font>
            </Label>

            <VBox spacing="4">
                <Label style="-fx-text-fill: black;" text="Nombre completo *"><font><Font name="Segoe UI Bold" size="12" /></font></Label>
                <TextField fx:id="txtNombreEditar" prefHeight="34" style="-fx-background-color: #F0EFEB; -fx-border-color: #E5E1D8; -fx-border-radius: 4; -fx-background-radius: 4;" />
            </VBox>

            <VBox spacing="4">
                <Label style="-fx-text-fill: black;" text="Teléfono"><font><Font name="Segoe UI Bold" size="12" /></font></Label>
                <TextField fx:id="txtTelefonoEditar" prefHeight="34" style="-fx-background-color: #F0EFEB; -fx-border-color: #E5E1D8; -fx-border-radius: 4; -fx-background-radius: 4;" />
            </VBox>

            <VBox spacing="4">
                <Label style="-fx-text-fill: black;" text="Correo electrónico"><font><Font name="Segoe UI Bold" size="12" /></font></Label>
                <TextField fx:id="txtCorreoEditar" prefHeight="34" style="-fx-background-color: #F0EFEB; -fx-border-color: #E5E1D8; -fx-border-radius: 4; -fx-background-radius: 4;" />
            </VBox>

            <HBox alignment="CENTER_RIGHT">
                <Button onAction="#actualizarCliente" prefHeight="38" prefWidth="160" style="-fx-background-color: #5C3D2E; -fx-background-radius: 6;" text="Guardar Cambios" textFill="WHITE">
                    <font><Font name="Segoe UI Bold" size="13" /></font>
                    <cursor><Cursor fx:constant="HAND" /></cursor>
                </Button>
            </HBox>
        </VBox>

    </HBox>

</VBox>
</content>
</ScrollPane>
