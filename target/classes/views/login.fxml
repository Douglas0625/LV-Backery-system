<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.effect.ColorAdjust?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<StackPane xmlns="http://javafx.com/javafx/26"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="controller.LoginController"
           style="-fx-background-color: #F0EFEB;">

    <children>

        <VBox alignment="CENTER"
              spacing="20"
              fillWidth="false">

            <padding>
                <Insets top="30" bottom="30" left="30" right="30"/>
            </padding>

            <!-- LOGO -->
            <ImageView fitHeight="285"
                       fitWidth="339"
                       pickOnBounds="true"
                       preserveRatio="true">

                <image>
                    <Image url="@../img/LogoLVBakery.jpeg"/>
                </image>

            </ImageView>

            <!-- TITULO -->
            <Label alignment="CENTER"
                   contentDisplay="CENTER"
                   text="Sistema de Gestion de Panaderia - LV Bakery">

                <font>
                    <Font name="Segoe UI Bold" size="18"/>
                </font>

            </Label>

            <!-- CARD LOGIN -->
            <Pane prefHeight="234"
                  prefWidth="362"
                  style="-fx-background-color: #FFFFFF;
                         -fx-background-radius: 6;
                         -fx-border-color: #E5E1D8;
                         -fx-border-radius: 6;
                         -fx-border-width: 2;">

                <children>

                    <!-- USUARIO -->
                    <Label layoutX="38"
                           layoutY="38"
                           text="Usuario">

                        <font>
                            <Font name="Segoe UI Bold" size="12"/>
                        </font>

                    </Label>

                    <TextField fx:id="txtUsuario"
                               layoutX="37"
                               layoutY="61"
                               prefHeight="27"
                               prefWidth="290"
                               style="-fx-background-color: #F0EFEB;
                                      -fx-border-color: #E5E1D8;
                                      -fx-background-radius: 4;
                                      -fx-border-radius: 4;" />

                    <!-- PASSWORD -->
                    <Label layoutX="36"
                           layoutY="97"
                           text="Contraseña">

                        <font>
                            <Font name="Segoe UI Bold" size="12"/>
                        </font>

                    </Label>

                    <PasswordField fx:id="txtPassword"
                                   layoutX="35"
                                   layoutY="124"
                                   prefHeight="27"
                                   prefWidth="290"
                                   style="-fx-background-color: #F0EFEB;
                                          -fx-border-color: #E5E1D8;
                                          -fx-background-radius: 4;
                                          -fx-border-radius: 4;" />

                    <!-- BOTON -->
                    <Button fx:id="btnIniciarSesion"
                            alignment="CENTER"
                            layoutX="92"
                            layoutY="175"
                            mnemonicParsing="false"
                            onAction="#iniciarSesion"
                            prefHeight="38"
                            prefWidth="177"
                            style="-fx-background-color: #331B0F;
                                   -fx-background-radius: 5;
                                   -fx-text-fill: white;"
                            text="Iniciar Sesion"
                            textAlignment="CENTER">

                        <cursor>
                            <Cursor fx:constant="HAND"/>
                        </cursor>

                        <effect>
                            <ColorAdjust/>
                        </effect>

                        <font>
                            <Font name="Segoe UI Bold" size="14"/>
                        </font>

                    </Button>

                </children>

            </Pane>

        </VBox>

    </children>

</StackPane>