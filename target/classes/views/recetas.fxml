<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="720.0" prefWidth="1280.0" style="-fx-background-color: #F5F3EF;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.RecetasController">

    <!-- ================= CONTENIDO ================= -->
    <center>
        <ScrollPane fitToHeight="true" fitToWidth="true" pannable="true" prefHeight="746.0" prefWidth="1302.0" style="-fx-background: #F5F3EF;">
            <content>
                <VBox spacing="20">
                    <children>

                        <!-- HEADER -->
                        <HBox alignment="CENTER_LEFT">
                            <children>
                                <VBox spacing="5">
                                    <children>
                                        <Label text="Gestión de Productos y Recetas" textFill="#3E2C27">
                                            <font><Font name="Segoe UI Bold" size="24.0" /></font>
                                        </Label>
                                        <Label text="Administre productos, recetas e ingredientes" textFill="#7A6E69">
                                            <font><Font name="Segoe UI" size="14" /></font>
                                        </Label>
                                    </children>
                                </VBox>
                                <Region HBox.hgrow="ALWAYS" />
                            </children>
                            <VBox.margin><Insets left="25.0" right="25.0" top="15.0" /></VBox.margin>
                        </HBox>

                        <!-- CUERPO PRINCIPAL -->
                        <HBox spacing="20">
                            <children>

                                <!-- ═══ TABLA IZQUIERDA ═══ -->
                                <VBox spacing="10" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 15;" HBox.hgrow="ALWAYS">
                                    <children>
                                        <HBox alignment="CENTER_LEFT">
                                            <children>
                                                <Label text="Productos Registrados" textFill="#3E2C27">
                                                    <font><Font name="Segoe UI Bold" size="18.0" /></font>
                                                </Label>
                                                <Region HBox.hgrow="ALWAYS" />
                                                <!-- Búsqueda en vivo -->
                                                <TextField fx:id="txtBuscar" prefWidth="220" promptText="Buscar producto..." />
                                            </children>
                                        </HBox>

                                        <TableView fx:id="tablaRecetas" prefHeight="600" VBox.vgrow="ALWAYS">
                                            <columns>
                                                <TableColumn fx:id="colProductoRec" prefWidth="200" text="PRODUCTO" />
                                                <TableColumn fx:id="colPrecioRec" prefWidth="90" text="PRECIO" />
                                                <TableColumn fx:id="colCostoRec" prefWidth="90" text="COSTO" />
                                                <TableColumn fx:id="colRendimientoRec" prefWidth="110" text="RENDIMIENTO" />
                                                <TableColumn fx:id="colAccionRec" prefWidth="100" text="ACCIÓN" />
                                            </columns>
                                        </TableView>
                                    </children>
                                </VBox>

                                <!-- ═══ PANEL DERECHO ═══ -->
                                <VBox maxWidth="420" minWidth="420" prefWidth="420" spacing="18">
                                    <children>

                                        <VBox prefHeight="754.0" prefWidth="420.0" spacing="14" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 15;">
                                            <children>

                                                <Label text="Producto y Receta" textFill="#3E2C27">
                                                    <font><Font name="Segoe UI Bold" size="24.0" /></font>
                                                </Label>

                                                <!-- ── SECCIÓN PRODUCTO ── -->
                                                <Separator />
                                                <Label text="Datos del Producto" textFill="#8B4A2F">
                                                    <font><Font name="Segoe UI Bold" size="18.0" /></font>
                                                </Label>

                                                <!-- Nombre producto -->
                                                <VBox spacing="5">
                                                    <children>
                                                        <Label text="Nombre del Producto">
                                             <font>
                                                <Font name="System Bold" size="12.0" />
                                             </font></Label>
                                                        <TextField fx:id="txtNombreProducto" promptText="Ej: Cheesecake" />
                                                    </children>
                                                </VBox>

                                                <!-- Descripción -->
                                                <VBox spacing="5">
                                                    <children>
                                                        <Label text="Descripción">
                                             <font>
                                                <Font name="System Bold" size="12.0" />
                                             </font></Label>
                                                        <TextArea fx:id="txtDescripcion" prefHeight="70" promptText="Descripción del producto" wrapText="true" />
                                                    </children>
                                                </VBox>

                                                <!-- Precio y unidades -->
                                                <HBox spacing="10">
                                                    <children>
                                                        <VBox spacing="5" HBox.hgrow="ALWAYS">
                                                            <children>
                                                                <Label text="Precio Venta">
                                                   <font>
                                                      <Font name="System Bold" size="12.0" />
                                                   </font></Label>
                                                                <TextField fx:id="txtPrecioVenta" promptText="0.00" />
                                                            </children>
                                                        </VBox>
                                                        <VBox spacing="5" HBox.hgrow="ALWAYS">
                                                            <children>
                                                                <Label text="Unidades / Presentación">
                                                   <font>
                                                      <Font name="System Bold" size="12.0" />
                                                   </font></Label>
                                                                <TextField fx:id="txtUnidades" promptText="Ej: 12" />
                                                            </children>
                                                        </VBox>
                                                    </children>
                                                </HBox>

                                                <!-- ── SECCIÓN RECETA ── -->
                                                <Separator />
                                                <Label text="Datos de la Receta" textFill="#8B4A2F">
                                                    <font><Font name="Segoe UI Bold" size="18.0" /></font>
                                                </Label>

                                                <!-- Nombre receta y rendimiento -->
                                                <HBox spacing="10">
                                                    <children>
                                                        <VBox spacing="5" HBox.hgrow="ALWAYS">
                                                            <children>
                                                                <Label text="Nombre de la Receta">
                                                   <font>
                                                      <Font name="System Bold" size="12.0" />
                                                   </font></Label>
                                                                <TextField fx:id="txtNombreReceta" promptText="Ej: Receta Cheesecake" />
                                                            </children>
                                                        </VBox>
                                                        <VBox spacing="5">
                                                            <children>
                                                                <Label text="Rendimiento">
                                                   <font>
                                                      <Font name="System Bold" size="12.0" />
                                                   </font></Label>
                                                                <TextField fx:id="txtRendimiento" prefWidth="100" promptText="Unidades" />
                                                            </children>
                                                        </VBox>
                                                    </children>
                                                </HBox>

                                                <!-- ── SECCIÓN INGREDIENTES ── -->
                                                <Separator />

                                                <HBox alignment="CENTER_LEFT">
                                                    <children>
                                                        <Label text="Ingredientes" textFill="#8B4A2F">
                                                            <font><Font name="Segoe UI Bold" size="18.0" /></font>
                                                        </Label>
                                                        <Region HBox.hgrow="ALWAYS" />
                                                        <Button onAction="#agregarIngredienteReceta" prefHeight="32" prefWidth="130" style="-fx-background-color: #D8B08C; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6;" text="+ Ingrediente">
                                                            <cursor><Cursor fx:constant="HAND" /></cursor>
                                                        </Button>
                                                    </children>
                                                </HBox>

                                                <TableView fx:id="tablaDetalleReceta" minHeight="200.0" prefHeight="149.0" prefWidth="380.0">
                                                    <columns>
                                                        <TableColumn fx:id="colIngredienteRec" prefWidth="155" text="INGREDIENTE" />
                                                        <TableColumn fx:id="colGramosRec" prefWidth="75" text="GRAMOS" />
                                                        <TableColumn fx:id="colCostoIngRec" prefWidth="75" text="COSTO" />
                                                        <TableColumn fx:id="colAccionIng" prefWidth="50" text="" />
                                                    </columns>
                                                </TableView>

                                                <!-- COSTO ESTIMADO -->
                                                <VBox prefHeight="54.0" prefWidth="380.0" spacing="4" style="-fx-background-color: #F2A47F; -fx-padding: 12; -fx-background-radius: 10;">
                                                    <children>
                                                        <Label text="COSTO ESTIMADO" textFill="#8A4B32">
                                                            <font><Font name="Segoe UI Bold" size="12" /></font>
                                                        </Label>
                                                        <Label fx:id="lblCostoEstimado" text="\$0.00 / unidad" textFill="#4B3832">
                                                            <font><Font name="Segoe UI Bold" size="26" /></font>
                                                        </Label>
                                                    </children>
                                                </VBox>

                                                <!-- BOTONES -->
                                                <HBox spacing="12">
                                                    <children>
                                                        <Button onAction="#limpiarFormulario" prefHeight="42" prefWidth="180" style="-fx-background-color: transparent; -fx-border-color: #3E2A24; -fx-border-radius: 8; -fx-background-radius: 8; -fx-font-weight: bold;" text="Limpiar">
                                                            <cursor><Cursor fx:constant="HAND" /></cursor>
                                                        </Button>
                                                        <Button onAction="#guardarReceta" prefHeight="42" prefWidth="180" style="-fx-background-color: #3E2A24; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8;" text="Guardar">
                                                            <cursor><Cursor fx:constant="HAND" /></cursor>
                                                        </Button>
                                                    </children>
                                                </HBox>

                                            </children>
                                        </VBox>

                                    </children>
                                </VBox>
                                <!-- fin panel derecho -->

                            </children>
                            <VBox.margin><Insets bottom="25.0" left="25.0" right="25.0" /></VBox.margin>
                        </HBox>

                    </children>
                </VBox>
            </content>
        </ScrollPane>
    </center>

</BorderPane>
